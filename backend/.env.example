# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Database option 1: Connection string (Render / Neon / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/joineazy_task1

# Database option 2: Individual parameters (Local / Docker)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=joineazy_task1

# SSL override: set true for managed remote Postgres, false for local/Docker Postgres
# DATABASE_SSL=false

# Auto-seed demo data on startup when users table is empty
SEED_DEMO_DATA=true
